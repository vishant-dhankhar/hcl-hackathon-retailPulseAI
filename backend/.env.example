DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
PORT=4000
NODE_ENV=development
DEMO_PASSWORD=
# OpenAI: keep this key in backend/.env only. Never use a VITE_ variable for it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, or Gemini's compatible API.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Embeddings may use a separate provider. The schema expects 1536 dimensions.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=uploads
